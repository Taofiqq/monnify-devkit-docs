    },
    {
      "source": "/customization",
      "destination": "/introduction",
      "permanent": false
    },
    {
      "source": "/guides/create-a-site",
      "destination": "/quickstart",
      "permanent": false
    },
    {
      "source": "/guides/work-with-the-cli",
      "destination": "/quickstart",
      "permanent": false
    },
    {
      "source": "/guides/connect-ai-tools",
      "destination": "/guides/debug-webhooks",
      "permanent": false
    },
    {
      "source": "/api",
      "destination": "/introduction",
      "permanent": false
    },
    {
      "source": "/api/introduction",
      "destination": "/introduction",
      "permanent": false
    },
    {
      "source": "/api/authentication",
      "destination": "/introduction",
      "permanent": false
    },
    {
      "source": "/changelog",
      "destination": "/introduction",
      "permanent": false
    }
  ]
}
