{
  "theme": "default",
  "appearance": {
    "contentIcons": "accent"
  },
  "markdown": {
    "enabled": true
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": [
      {
        "code": "en",
        "label": "English"
      }
    ]
  },
  "navbar": {
    "primary": {
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "tabs": [
    {
      "tab": "Documentation",
      "groups": [
        {
          "group": "Get started",
          "pages": [
            "introduction",
            "quickstart"
          ]
        },
        {
          "group": "Guides",
          "pages": [
            "guides/debug-webhooks"
          ]
        }
      ]
    },
    {
      "tab": "Build with Thally",
      "groups": [
        {
          "group": "Tutorial",
          "pages": [
            "articles/build-docs-with-thally"
          ]
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/components",
      "destination": "/introduction",
